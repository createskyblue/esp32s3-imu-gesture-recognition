menu "LCD + LVGL"

config LCD_LVGL_BUF_IN_PSRAM
    bool "LVGL draw buffers in PSRAM (else internal DRAM)"
    default y
    help
        Benchmark switch: y = PSRAM buffers (keeps internal RAM free),
        n = internal DRAM buffers. The display task logs the buffer
        location and a full-screen refresh benchmark at startup.

endmenu
